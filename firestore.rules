rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Teacher/Admin has full read and write access to all collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Public access required for the frontend form to work
    match /batches/{batchId} {
      allow read: if true;
    }
    
    match /students/{studentId} {
      allow read: if true;
    }
    
    // Public needs to read, create, and delete to submit and overwrite logs
    match /fieldwork_logs/{logId} {
      allow read, write: if true;
    }
  }
}
